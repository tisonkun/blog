---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageMeta from "@/components/PageMeta.astro";
import PostList from "@/components/PostList.astro";
import { getListedPosts, type PostEntry } from "@/lib/post";
import { Site } from "@/config";

interface Props {
    posts: PostEntry[];
    category: string;
}

export async function getStaticPaths() {
    const posts = await getListedPosts();
    const grouped = new Map<string, PostEntry[]>();
    for (const post of posts) {
        const list = grouped.get(post.data.category) ?? [];
        list.push(post);
        grouped.set(post.data.category, list);
    }
    return [...grouped.entries()].map(([category, categoryPosts]) => ({
        params: { category },
        props: { posts: categoryPosts, category },
    }));
}

const { posts, category } = Astro.props;
---

<BaseLayout title={`${category} | ${Site.title}`}>
    <PageMeta title={category} slot="meta" />
    <h1 class="text-center text-4xl font-bold mt-8">{category}</h1>
    <PostList posts={posts} />
</BaseLayout>
