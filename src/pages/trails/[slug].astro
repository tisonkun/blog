---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Giscus from "@/components/Giscus.astro";
import PostMeta from "@/components/PostMeta.astro";
import TrailListenBar from "@/components/TrailListenBar.astro";
import { Site } from "@/config";
import {
    formatTrailDate,
    getAllTrails,
    getTrailListenLinks,
    getTrailPageTitle,
    getTrailSummary,
    hasTrailBody,
    inferPlatformLabel,
    type TrailEntry,
} from "@/lib/trail";

interface Props {
    entry: TrailEntry;
}

export async function getStaticPaths() {
    const trails = await getAllTrails();
    return trails.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { slug } = Astro.params;

const { title, date, work, credit, wiki } = entry.data;
const pageTitle = getTrailPageTitle(entry);
const formattedDate = formatTrailDate(date);
const description = getTrailSummary(entry, 160);
const hasBody = hasTrailBody(entry);
const listenLinks = getTrailListenLinks(entry);
const hasMeta = Boolean(work || credit || wiki);
const wikiLabel = wiki ? inferPlatformLabel(wiki) : "";
const ogImageAbsoluteUrl = `${Site.baseUrl}/media/yatennosyo.png`;
const { Content } = hasBody ? await render(entry) : { Content: null };
---

<BaseLayout title={`${pageTitle} | 中二少年的轨迹 | ${Site.title}`}>
    <PostMeta
        title={`${pageTitle} | 中二少年的轨迹`}
        description={description}
        publishDate={date.toISOString()}
        pagePath={`/trails/${slug}`}
        ogImageAbsoluteUrl={ogImageAbsoluteUrl}
        ogImageAltText={pageTitle}
        ogImageWidth={1600}
        ogImageHeight={1200}
        slot="meta"
    />

    <article class="pt-8">
        <nav aria-label="返回导航" class="mb-6">
            <a
                href="/trails"
                class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-blue-600 transition-colors"
            >
                <span aria-hidden="true">←</span>
                <span>返回轨迹</span>
            </a>
        </nav>

        <header class="pb-5 border-b border-gray-900/10">
            <time
                datetime={date.toISOString()}
                class="font-mono text-xs text-gray-500 tabular-nums"
            >
                {formattedDate}
            </time>

            {
                title && (
                    <h1 class="mt-2 mb-0 text-3xl font-bold text-gray-900 leading-tight">
                        {title}
                    </h1>
                )
            }

            {
                hasMeta && (
                    <p class="mt-2 mb-0 text-sm text-gray-500 leading-relaxed flex flex-wrap items-center gap-x-1.5 gap-y-0.5">
                        {work && <span>《{work}》</span>}
                        {work && credit && <span class="text-gray-300">·</span>}
                        {credit && <span>{credit}</span>}
                        {(work || credit) && wiki && <span class="text-gray-300">·</span>}
                        {wiki && (
                            <a
                                href={wiki}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-gray-500 hover:text-blue-600 transition-colors"
                            >
                                {wikiLabel} ↗
                            </a>
                        )}
                    </p>
                )
            }
        </header>

        {
            Content && (
                <div class="post-content mt-6">
                    <Content />
                </div>
            )
        }

        <div class="mt-6">
            <TrailListenBar links={listenLinks} />
        </div>
    </article>

    <hr class="border-gray-200 mt-8 mb-6" />
    <section id="comments" aria-label="讨论串">
        <Giscus />
    </section>
</BaseLayout>
