---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Giscus from "@/components/Giscus.astro";
import PostMeta from "@/components/PostMeta.astro";
import TrailKindBadge from "@/components/TrailKindBadge.astro";
import { Site } from "@/config";
import {
    formatTrailDate,
    getAllTrails,
    getTrailLinks,
    getTrailSummary,
    hasTrailNote,
    type TrailEntry,
} from "@/lib/trail";

interface Props {
    entry: TrailEntry;
}

export async function getStaticPaths() {
    const trails = await getAllTrails();
    return trails.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { slug } = Astro.params;

const { title, date, kind, credit, source, quote, tags } = entry.data;
const formattedDate = formatTrailDate(date);
const description = getTrailSummary(entry, 160);
const links = getTrailLinks(entry);
const hasNote = hasTrailNote(entry);
const subtitle = [credit, source].filter(Boolean).join(" · ");
const ogImageAbsoluteUrl = `${Site.baseUrl}/media/yatennosyo.png`;
const { Content } = hasNote ? await render(entry) : { Content: null };
---

<BaseLayout title={`${title} | 轨迹 | ${Site.title}`}>
    <PostMeta
        title={`${title} | 轨迹`}
        description={description}
        publishDate={date.toISOString()}
        pagePath={`/trails/${slug}`}
        ogImageAbsoluteUrl={ogImageAbsoluteUrl}
        ogImageAltText={title}
        ogImageWidth={1600}
        ogImageHeight={1200}
        slot="meta"
    />

    <article class="pt-8">
        <nav aria-label="返回导航" class="mb-6">
            <a
                href="/trails"
                class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-blue-600 transition-colors"
            >
                <svg
                    class="w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="m15 18-6-6 6-6" />
                </svg>
                <span>返回轨迹</span>
            </a>
        </nav>

        <header class="pb-5 border-b border-gray-900/10">
            <div class="flex items-center gap-3">
                <TrailKindBadge kind={kind} />
                <time
                    datetime={date.toISOString()}
                    class="font-mono text-xs text-gray-500 tabular-nums"
                >
                    {formattedDate}
                </time>
            </div>
            <h1 class="mt-3 mb-0 text-3xl font-bold text-gray-900 leading-tight">
                {title}
            </h1>
            {
                subtitle && (
                    <p class="mt-2 mb-0 text-sm text-gray-500 leading-relaxed">
                        {subtitle}
                    </p>
                )
            }
        </header>

        {
            quote && (
                <div class="mt-6 rounded-xl border border-[#e7e5e0] bg-[#f8f8f6] px-5 py-4 text-base leading-relaxed text-gray-800 whitespace-pre-line">
                    {quote}
                </div>
            )
        }

        {
            links.length > 0 && (
                <div class="mt-6 flex flex-wrap gap-2">
                    {links.map((link) => (
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2 text-sm font-medium text-gray-800 hover:border-blue-300 hover:bg-blue-50/60 hover:text-blue-700 transition-colors"
                        >
                            <span>{link.label}</span>
                            <svg
                                class="w-3.5 h-3.5 opacity-70"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M7 17 17 7" />
                                <path d="M7 7h10v10" />
                            </svg>
                        </a>
                    ))}
                </div>
            )
        }

        {
            Content && (
                <div class="post-content mt-6">
                    <Content />
                </div>
            )
        }

        {
            tags.length > 0 && (
                <div class="mt-8 flex flex-wrap items-center gap-2">
                    <span class="text-sm text-gray-500 mr-1">标签</span>
                    {tags.map((tag) => (
                        <a
                            href={`/trails?tag=${encodeURIComponent(tag)}`}
                            class="inline-block rounded-md border border-blue-600/80 px-2.5 py-0.5 text-sm text-blue-600 hover:bg-blue-50 transition-colors"
                        >
                            #{tag}
                        </a>
                    ))}
                </div>
            )
        }
    </article>

    <hr class="border-gray-200 mt-8 mb-6" />
    <section id="comments" aria-label="讨论串">
        <Giscus />
    </section>
</BaseLayout>
