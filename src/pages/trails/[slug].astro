---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Giscus from "@/components/Giscus.astro";
import PostMeta from "@/components/PostMeta.astro";
import TrailKindBadge from "@/components/TrailKindBadge.astro";
import { Site } from "@/config";
import {
    formatTrailDate,
    getAllTrails,
    getTrailSummary,
    hasTrailBody,
    type TrailEntry,
} from "@/lib/trail";

interface Props {
    entry: TrailEntry;
}

export async function getStaticPaths() {
    const trails = await getAllTrails();
    return trails.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { slug } = Astro.params;

const { title, date, kind, credit, source, tags } = entry.data;
const formattedDate = formatTrailDate(date);
const description = getTrailSummary(entry, 160);
const hasBody = hasTrailBody(entry);
const subtitle = [credit, source].filter(Boolean).join(" · ");
const ogImageAbsoluteUrl = `${Site.baseUrl}/media/yatennosyo.png`;
const { Content } = hasBody ? await render(entry) : { Content: null };
---

<BaseLayout title={`${title} | 中二少年的轨迹 | ${Site.title}`}>
    <PostMeta
        title={`${title} | 中二少年的轨迹`}
        description={description}
        publishDate={date.toISOString()}
        pagePath={`/trails/${slug}`}
        ogImageAbsoluteUrl={ogImageAbsoluteUrl}
        ogImageAltText={title}
        ogImageWidth={1600}
        ogImageHeight={1200}
        slot="meta"
    />

    <article class="pt-8">
        <nav aria-label="返回导航" class="mb-6">
            <a
                href="/trails"
                class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-blue-600 transition-colors"
            >
                <span aria-hidden="true">←</span>
                <span>返回轨迹</span>
            </a>
        </nav>

        <header class="pb-5 border-b border-gray-900/10">
            <div class="flex items-center gap-3">
                <TrailKindBadge kind={kind} />
                <time
                    datetime={date.toISOString()}
                    class="font-mono text-xs text-gray-500 tabular-nums"
                >
                    {formattedDate}
                </time>
            </div>
            <h1 class="mt-3 mb-0 text-3xl font-bold text-gray-900 leading-tight">
                {title}
            </h1>
            {
                subtitle && (
                    <p class="mt-2 mb-0 text-sm text-gray-500 leading-relaxed">
                        {subtitle}
                    </p>
                )
            }
        </header>

        {
            Content && (
                <div class="post-content mt-6">
                    <Content />
                </div>
            )
        }

        {
            tags.length > 0 && (
                <div class="mt-8 flex flex-wrap items-center gap-2">
                    <span class="text-sm text-gray-500 mr-1">标签</span>
                    {tags.map((tag) => (
                        <a
                            href={`/trails?tag=${encodeURIComponent(tag)}`}
                            class="inline-block rounded-md border border-blue-600/80 px-2.5 py-0.5 text-sm text-blue-600 hover:bg-blue-50 transition-colors"
                        >
                            #{tag}
                        </a>
                    ))}
                </div>
            )
        }
    </article>

    <hr class="border-gray-200 mt-8 mb-6" />
    <section id="comments" aria-label="讨论串">
        <Giscus />
    </section>
</BaseLayout>
