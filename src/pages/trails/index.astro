---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageMeta from "@/components/PageMeta.astro";
import TrailCard from "@/components/TrailCard.astro";
import { Site } from "@/config";
import { countTerms } from "@/lib/post";
import { getAllTrails, sortTrailsByDateDesc } from "@/lib/trail";

const trails = sortTrailsByDateDesc(await getAllTrails());
const totalCount = trails.length;
const sortedWorks = countTerms(
    trails
        .map((entry) => entry.data.work?.trim())
        .filter((work): work is string => Boolean(work)),
);

const title = "中二少年的轨迹";
---

<BaseLayout title={`${title} | ${Site.title}`}>
    <PageMeta title={title} slot="meta" />

    <section class="mt-8">
        <h1 class="my-0 text-3xl font-bold text-gray-900">{title}</h1>

        <div
            class="mt-6 pb-3.5 border-b border-gray-900/10 flex flex-wrap items-center justify-between gap-3"
        >
            <div class="flex flex-wrap items-center gap-2">
                {
                    sortedWorks.length > 0 && (
                        <div class="relative" id="trail-work-dropdown">
                            <button
                                type="button"
                                id="trail-work-trigger"
                                aria-haspopup="listbox"
                                aria-expanded="false"
                                class="trail-work-btn inline-flex items-center gap-2 cursor-pointer rounded-lg border border-gray-900/14 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:border-gray-900/30 hover:text-gray-900 transition-colors"
                            >
                                <span id="trail-work-label">全部作品</span>
                                <svg
                                    id="trail-work-chevron"
                                    class="w-3.5 h-3.5 text-gray-400 transition-transform duration-150"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="m6 9 6 6 6-6" />
                                </svg>
                            </button>

                            <div
                                id="trail-work-menu"
                                role="listbox"
                                aria-label="按作品筛选"
                                hidden
                                class="absolute left-0 top-full z-20 mt-1.5 min-w-[14rem] max-w-[20rem] max-h-72 overflow-y-auto rounded-lg border border-gray-900/12 bg-white py-1 shadow-[0_8px_24px_rgba(17,24,39,0.1)]"
                            >
                                <button
                                    type="button"
                                    role="option"
                                    aria-selected="true"
                                    data-work-option=""
                                    class="trail-work-option trail-work-option-active w-full flex items-center justify-between gap-3 cursor-pointer border-0 bg-transparent px-3 py-1.5 text-left text-xs transition-colors"
                                >
                                    <span class="truncate">全部作品</span>
                                    <span class="font-mono text-[11px] text-gray-400 tabular-nums shrink-0">
                                        {totalCount}
                                    </span>
                                </button>
                                <div class="my-1 border-t border-gray-900/8" />
                                {sortedWorks.map(({ name, count }) => (
                                    <button
                                        type="button"
                                        role="option"
                                        aria-selected="false"
                                        data-work-option={name}
                                        class="trail-work-option w-full flex items-center justify-between gap-3 cursor-pointer border-0 bg-transparent px-3 py-1.5 text-left text-xs transition-colors"
                                    >
                                        <span class="truncate">{name}</span>
                                        <span class="font-mono text-[11px] text-gray-400 tabular-nums shrink-0">
                                            {count}
                                        </span>
                                    </button>
                                ))}
                            </div>
                        </div>
                    )
                }

                <button
                    type="button"
                    id="trail-work-clear"
                    hidden
                    class="cursor-pointer border-0 bg-transparent px-1 py-1 text-xs text-gray-400 hover:text-blue-600 transition-colors"
                >
                    清除筛选
                </button>
            </div>

            <div
                class="inline-flex items-center rounded-lg border border-gray-900/12 bg-gray-50/80 p-0.5"
                role="group"
                aria-label="排序方式"
            >
                <button
                    type="button"
                    data-sort-mode="newest"
                    aria-pressed="true"
                    class="trail-sort-btn trail-sort-active cursor-pointer rounded-md border-0 px-3 py-1 text-xs font-medium transition-colors"
                >
                    最新
                </button>
                <button
                    type="button"
                    data-sort-mode="oldest"
                    aria-pressed="false"
                    class="trail-sort-btn cursor-pointer rounded-md border-0 px-3 py-1 text-xs font-medium transition-colors"
                >
                    最早
                </button>
                <button
                    type="button"
                    data-sort-mode="random"
                    aria-pressed="false"
                    title="随机排序，再次点击可重新随机"
                    class="trail-sort-btn inline-flex items-center gap-1 cursor-pointer rounded-md border-0 px-3 py-1 text-xs font-medium transition-colors"
                >
                    <span>随机</span>
                    <svg
                        id="trail-reshuffle-icon"
                        class="hidden w-3 h-3 text-gray-400"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                        <path d="M21 3v6h-6" />
                    </svg>
                </button>
            </div>
        </div>

        <ul
            id="trail-list"
            class="mt-6 mb-0 p-0 space-y-6 list-none"
            data-total={totalCount}
        >
            {trails.map((entry, index) => <TrailCard entry={entry} index={index} />)}
        </ul>

        <div
            id="trail-empty"
            hidden
            class="mt-8 rounded-xl border border-dashed border-gray-300 px-6 py-10 text-center"
        >
            <p class="my-0 text-sm text-gray-500">该作品下暂无记录。</p>
            <button
                type="button"
                id="trail-empty-reset"
                class="mt-3 cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-1 text-xs font-medium text-gray-700 hover:border-gray-400 hover:text-gray-900"
            >
                查看全部
            </button>
        </div>
    </section>
</BaseLayout>

<style>
    .trail-work-btn-active {
        border-color: rgba(37, 99, 235, 0.35);
        background-color: #eff6ff;
        color: #1d4ed8;
    }

    .trail-work-btn-active:hover {
        border-color: rgba(37, 99, 235, 0.5);
        color: #1d4ed8;
    }

    .trail-work-option {
        color: #374151;
    }

    .trail-work-option:hover {
        background-color: #f3f4f6;
        color: #111827;
    }

    .trail-work-option-active {
        background-color: #eff6ff;
        color: #1d4ed8;
        font-weight: 500;
    }

    .trail-work-option-active:hover {
        background-color: #dbeafe;
        color: #1d4ed8;
    }

    .trail-sort-btn {
        background-color: transparent;
        color: #6b7280;
    }

    .trail-sort-btn:hover {
        color: #111827;
    }

    .trail-sort-active {
        background-color: #fff;
        color: #111827;
        box-shadow: 0 1px 2px rgba(17, 24, 39, 0.08);
    }

    @keyframes trail-settle {
        from {
            opacity: 0.45;
            transform: translateY(4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes trail-spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    :global(#trail-list.is-shuffling [data-trail-card]) {
        animation: trail-settle 0.22s ease-out;
    }

    #trail-reshuffle-icon.is-spinning {
        animation: trail-spin 0.32s ease-out;
    }

    :global([data-trail-card][hidden]),
    #trail-work-menu[hidden],
    #trail-work-clear[hidden],
    #trail-empty[hidden] {
        display: none !important;
    }
</style>

<script>
    const list = document.getElementById("trail-list");
    if (list) {
        const listEl: HTMLElement = list;
        const cards = Array.from(listEl.querySelectorAll<HTMLElement>("[data-trail-card]"));
        const dropdown = document.getElementById("trail-work-dropdown");
        const trigger = document.getElementById("trail-work-trigger") as HTMLButtonElement | null;
        const triggerLabel = document.getElementById("trail-work-label");
        const chevron = document.getElementById("trail-work-chevron");
        const menu = document.getElementById("trail-work-menu");
        const workOptions = Array.from(
            document.querySelectorAll<HTMLButtonElement>("[data-work-option]"),
        );
        const clearBtn = document.getElementById("trail-work-clear") as HTMLButtonElement | null;
        const sortButtons = Array.from(
            document.querySelectorAll<HTMLButtonElement>("[data-sort-mode]"),
        );
        const reshuffleIcon = document.getElementById("trail-reshuffle-icon");
        const emptyState = document.getElementById("trail-empty");
        const emptyResetBtn = document.getElementById("trail-empty-reset");

        const validWorks = new Set(
            workOptions.map((opt) => opt.dataset.workOption ?? "").filter(Boolean),
        );

        const params = new URLSearchParams(window.location.search);
        const initialWork = params.get("work");
        const initialOrder = params.get("order");

        let activeWork = initialWork && validWorks.has(initialWork) ? initialWork : "";
        let sortMode: "newest" | "oldest" | "random" =
            initialOrder === "oldest" || initialOrder === "random" ? initialOrder : "newest";
        let randomOrder = cards.map((_, idx) => idx);

        const cardMeta = cards.map((el, index) => ({
            el,
            index,
            work: el.dataset.work || "",
        }));

        function setMenuOpen(open: boolean) {
            if (!menu || !trigger) return;
            menu.hidden = !open;
            trigger.setAttribute("aria-expanded", String(open));
            if (chevron) {
                chevron.style.transform = open ? "rotate(180deg)" : "";
            }
        }

        function shuffleOrder(prev: number[]): number[] {
            const next = [...prev];
            for (let i = next.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [next[i], next[j]] = [next[j], next[i]];
            }
            if (next.length > 1 && next.every((v, idx) => v === prev[idx])) {
                [next[0], next[1]] = [next[1], next[0]];
            }
            return next;
        }

        function syncUrl() {
            const url = new URL(window.location.href);
            url.searchParams.delete("work");
            url.searchParams.delete("order");

            if (activeWork) {
                url.searchParams.set("work", activeWork);
            }
            if (sortMode !== "newest") {
                url.searchParams.set("order", sortMode);
            }
            window.history.replaceState({}, "", url.pathname + url.search + url.hash);
        }

        function getOrderedIndices(): number[] {
            if (sortMode === "oldest") {
                return cardMeta.map((c) => c.index).reverse();
            }
            if (sortMode === "random") {
                return randomOrder;
            }
            return cardMeta.map((c) => c.index);
        }

        function render(animate = false) {
            const order = getOrderedIndices();
            const fragment = document.createDocumentFragment();
            let visibleCount = 0;

            for (const idx of order) {
                const item = cardMeta[idx];
                const visible = !activeWork || item.work === activeWork;
                item.el.hidden = !visible;
                if (visible) {
                    visibleCount += 1;
                }
                fragment.appendChild(item.el);
            }

            listEl.appendChild(fragment);

            listEl.classList.remove("is-shuffling");
            if (animate) {
                void listEl.offsetWidth;
                listEl.classList.add("is-shuffling");
                listEl.addEventListener(
                    "animationend",
                    () => listEl.classList.remove("is-shuffling"),
                    { once: true },
                );
            }

            if (trigger && triggerLabel) {
                triggerLabel.textContent = activeWork ? `《${activeWork}》` : "全部作品";
                trigger.classList.toggle("trail-work-btn-active", Boolean(activeWork));
            }

            if (clearBtn) {
                clearBtn.hidden = !activeWork;
            }

            for (const opt of workOptions) {
                const isActive = (opt.dataset.workOption ?? "") === activeWork;
                opt.classList.toggle("trail-work-option-active", isActive);
                opt.setAttribute("aria-selected", String(isActive));
            }

            for (const btn of sortButtons) {
                const isActive = btn.dataset.sortMode === sortMode;
                btn.classList.toggle("trail-sort-active", isActive);
                btn.setAttribute("aria-pressed", String(isActive));
            }

            if (reshuffleIcon) {
                reshuffleIcon.classList.toggle("hidden", sortMode !== "random");
                if (animate && sortMode === "random") {
                    reshuffleIcon.classList.remove("is-spinning");
                    void reshuffleIcon.getBoundingClientRect();
                    reshuffleIcon.classList.add("is-spinning");
                }
            }

            if (emptyState) {
                emptyState.hidden = visibleCount > 0;
            }

            syncUrl();
        }

        if (sortMode === "random") {
            randomOrder = shuffleOrder(randomOrder);
        }

        trigger?.addEventListener("click", (event) => {
            event.stopPropagation();
            setMenuOpen(Boolean(menu?.hidden));
        });

        for (const opt of workOptions) {
            opt.addEventListener("click", () => {
                activeWork = opt.dataset.workOption ?? "";
                setMenuOpen(false);
                render();
            });
        }

        document.addEventListener("click", (event) => {
            if (!dropdown || menu?.hidden) return;
            if (!dropdown.contains(event.target as Node)) {
                setMenuOpen(false);
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && !menu?.hidden) {
                setMenuOpen(false);
            }
        });

        for (const btn of sortButtons) {
            btn.addEventListener("click", () => {
                const mode = btn.dataset.sortMode;
                if (mode === "random") {
                    sortMode = "random";
                    randomOrder = shuffleOrder(randomOrder);
                    render(true);
                } else if (mode === "oldest") {
                    sortMode = "oldest";
                    render(true);
                } else {
                    sortMode = "newest";
                    render(true);
                }
            });
        }

        listEl.addEventListener("click", (event) => {
            const target = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
                "[data-card-work]",
            );
            if (!target) return;
            const work = target.dataset.cardWork ?? "";
            if (!work) return;
            activeWork = activeWork === work ? "" : work;
            render();
        });

        const clearWork = () => {
            activeWork = "";
            render();
        };

        clearBtn?.addEventListener("click", clearWork);
        emptyResetBtn?.addEventListener("click", clearWork);

        render(false);
    }
</script>
