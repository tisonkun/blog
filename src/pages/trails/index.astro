---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageMeta from "@/components/PageMeta.astro";
import TrailCard from "@/components/TrailCard.astro";
import { Site } from "@/config";
import { countTerms } from "@/lib/post";
import {
    getAllTrails,
    sortTrailsByDateDesc,
    TRAIL_KIND_META,
    TRAIL_KIND_ORDER,
} from "@/lib/trail";

const trails = sortTrailsByDateDesc(await getAllTrails());
const totalCount = trails.length;
const sortedTags = countTerms(trails.flatMap((entry) => entry.data.tags));
const kindCounts = new Map<string, number>();
for (const entry of trails) {
    kindCounts.set(entry.data.kind, (kindCounts.get(entry.data.kind) ?? 0) + 1);
}

const title = "中二少年的轨迹";
---

<BaseLayout title={`${title} | ${Site.title}`}>
    <PageMeta title={title} slot="meta" />

    <section class="mt-8">
        <h1 class="my-0 text-3xl font-bold text-gray-900">{title}</h1>

        <div
            class="mt-6 pb-3.5 border-b border-gray-900/10 flex flex-wrap items-center justify-between gap-3"
        >
            <div class="flex flex-wrap items-center gap-2" role="group" aria-label="多条件筛选">
                <label class="trail-select-wrap">
                    <span class="sr-only">按类型筛选</span>
                    <select id="trail-kind-select" class="trail-select">
                        <option value="all">全部类型（{totalCount}）</option>
                        {
                            TRAIL_KIND_ORDER.filter(
                                (kind) => (kindCounts.get(kind) ?? 0) > 0,
                            ).map((kind) => (
                                <option value={kind}>
                                    {TRAIL_KIND_META[kind].label}（{kindCounts.get(kind)}）
                                </option>
                            ))
                        }
                    </select>
                </label>

                {
                    sortedTags.length > 0 && (
                        <label class="trail-select-wrap">
                            <span class="sr-only">按标签筛选</span>
                            <select id="trail-tag-select" class="trail-select">
                                <option value="">筛选标签…</option>
                                {sortedTags.map(({ name, count }) => (
                                    <option value={name}>
                                        #{name}（{count}）
                                    </option>
                                ))}
                            </select>
                        </label>
                    )
                }
            </div>

            <div
                class="inline-flex items-center rounded-lg border border-gray-900/12 bg-gray-50/80 p-0.5"
                role="group"
                aria-label="排序方式"
            >
                <button
                    type="button"
                    data-sort-mode="time"
                    aria-pressed="true"
                    class="trail-sort-btn trail-sort-active cursor-pointer rounded-md border-0 px-3 py-1 text-xs font-medium transition-colors"
                >
                    按时间
                </button>
                <button
                    type="button"
                    data-sort-mode="shuffle"
                    aria-pressed="false"
                    class="trail-sort-btn cursor-pointer rounded-md border-0 px-3 py-1 text-xs font-medium transition-colors"
                >
                    手气不错
                </button>
            </div>
        </div>

        <div
            id="trail-active-filters"
            class="mt-3 hidden flex-wrap items-center justify-between gap-2 text-xs text-gray-500"
        >
            <div id="trail-filter-chips" class="flex flex-wrap items-center gap-1.5"></div>
            <div class="flex items-center gap-3 shrink-0">
                <span id="trail-count-text"></span>
                <button
                    type="button"
                    id="trail-reset-btn"
                    class="cursor-pointer border-0 bg-transparent p-0 text-xs text-blue-600 hover:text-gray-600"
                >
                    清空筛选
                </button>
            </div>
        </div>

        <ul
            id="trail-list"
            class="mt-6 mb-0 p-0 space-y-6 list-none"
            data-total={totalCount}
        >
            {trails.map((entry, index) => <TrailCard entry={entry} index={index} />)}
        </ul>

        <div
            id="trail-empty"
            class="hidden mt-8 rounded-xl border border-dashed border-gray-300 px-6 py-10 text-center"
        >
            <p class="my-0 text-sm text-gray-500">当前筛选条件下暂无记录。</p>
            <button
                type="button"
                id="trail-empty-reset"
                class="mt-3 cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-1 text-xs font-medium text-gray-700 hover:border-gray-400 hover:text-gray-900"
            >
                查看全部
            </button>
        </div>
    </section>
</BaseLayout>

<style>
    .trail-select-wrap {
        display: inline-flex;
        align-items: center;
    }

    .trail-select {
        cursor: pointer;
        border-radius: 0.5rem;
        border: 1px solid rgba(17, 24, 39, 0.14);
        background-color: #fff;
        padding: 0.35rem 0.65rem;
        font-size: 0.8rem;
        line-height: 1.4;
        color: #374151;
        transition: border-color 0.15s ease, color 0.15s ease;
    }

    .trail-select:hover,
    .trail-select:focus {
        border-color: rgba(17, 24, 39, 0.3);
        color: #111827;
        outline: none;
    }

    .trail-sort-btn {
        background-color: transparent;
        color: #6b7280;
    }

    .trail-sort-btn:hover {
        color: #111827;
    }

    .trail-sort-active {
        background-color: #fff;
        color: #111827;
        box-shadow: 0 1px 2px rgba(17, 24, 39, 0.08);
    }

    :global(.trail-active-chip) {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        cursor: pointer;
        border-radius: 0.375rem;
        border: 1px solid rgba(37, 99, 235, 0.25);
        background-color: #eff6ff;
        padding: 0.15rem 0.5rem;
        font-size: 0.75rem;
        color: #1d4ed8;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    :global(.trail-active-chip:hover) {
        border-color: rgba(37, 99, 235, 0.45);
        background-color: #dbeafe;
    }

    @keyframes trail-settle {
        from {
            opacity: 0.45;
            transform: translateY(4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    :global(#trail-list.is-shuffling [data-trail-card]) {
        animation: trail-settle 0.22s ease-out;
    }

    :global([data-trail-card][hidden]) {
        display: none !important;
    }
</style>

<script>
    const list = document.getElementById("trail-list");
    if (list) {
        const listEl: HTMLElement = list;
        const cards = Array.from(listEl.querySelectorAll<HTMLElement>("[data-trail-card]"));
        const kindSelect = document.getElementById("trail-kind-select") as HTMLSelectElement | null;
        const tagSelect = document.getElementById("trail-tag-select") as HTMLSelectElement | null;
        const sortButtons = Array.from(
            document.querySelectorAll<HTMLButtonElement>("[data-sort-mode]"),
        );
        const activeFiltersBar = document.getElementById("trail-active-filters");
        const filterChipsContainer = document.getElementById("trail-filter-chips");
        const countText = document.getElementById("trail-count-text");
        const resetBtn = document.getElementById("trail-reset-btn");
        const emptyState = document.getElementById("trail-empty");
        const emptyResetBtn = document.getElementById("trail-empty-reset");

        const kindLabels: Record<string, string> = {
            song: "曲目",
            quote: "台词",
            reference: "拾遗",
        };

        const validKinds = new Set(
            kindSelect ? Array.from(kindSelect.options).map((opt) => opt.value) : ["all"],
        );
        const validTags = new Set(
            tagSelect
                ? Array.from(tagSelect.options)
                      .map((opt) => opt.value)
                      .filter(Boolean)
                : [],
        );

        const params = new URLSearchParams(window.location.search);
        const initialKind = params.get("kind");
        const initialTags = params.getAll("tag").filter((tag) => validTags.has(tag));
        const initialOrder = params.get("order");

        let activeKind = initialKind && validKinds.has(initialKind) ? initialKind : "all";
        const activeTags = new Set<string>(initialTags);
        let sortMode: "time" | "shuffle" = initialOrder === "random" ? "shuffle" : "time";
        let currentOrder = cards.map((_, idx) => idx);

        function parseTags(card: HTMLElement): string[] {
            try {
                const raw = card.dataset.tags;
                return raw ? JSON.parse(raw) : [];
            } catch {
                return [];
            }
        }

        const cardMeta = cards.map((el, index) => ({
            el,
            index,
            kind: el.dataset.kind || "reference",
            tags: parseTags(el),
        }));

        function shuffleOrder(prev: number[]): number[] {
            const next = [...prev];
            for (let i = next.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [next[i], next[j]] = [next[j], next[i]];
            }
            if (next.length > 1 && next.every((v, idx) => v === prev[idx])) {
                [next[0], next[1]] = [next[1], next[0]];
            }
            return next;
        }

        function syncUrl() {
            const url = new URL(window.location.href);
            url.searchParams.delete("kind");
            url.searchParams.delete("tag");
            url.searchParams.delete("order");

            if (activeKind !== "all") {
                url.searchParams.set("kind", activeKind);
            }
            for (const tag of activeTags) {
                url.searchParams.append("tag", tag);
            }
            if (sortMode === "shuffle") {
                url.searchParams.set("order", "random");
            }
            window.history.replaceState({}, "", url.pathname + url.search + url.hash);
        }

        function renderFilterChips(visibleCount: number) {
            if (!activeFiltersBar || !filterChipsContainer || !countText) return;
            const hasFilter = activeKind !== "all" || activeTags.size > 0;

            filterChipsContainer.replaceChildren();
            if (!hasFilter) {
                activeFiltersBar.classList.add("hidden");
                activeFiltersBar.classList.remove("flex");
                return;
            }

            if (activeKind !== "all") {
                const chip = document.createElement("button");
                chip.type = "button";
                chip.className = "trail-active-chip";
                chip.textContent = `类型：${kindLabels[activeKind] ?? activeKind} ×`;
                chip.addEventListener("click", () => {
                    activeKind = "all";
                    render();
                });
                filterChipsContainer.appendChild(chip);
            }

            for (const tag of activeTags) {
                const chip = document.createElement("button");
                chip.type = "button";
                chip.className = "trail-active-chip";
                chip.textContent = `#${tag} ×`;
                chip.addEventListener("click", () => {
                    activeTags.delete(tag);
                    render();
                });
                filterChipsContainer.appendChild(chip);
            }

            countText.textContent = `显示 ${visibleCount} / ${cards.length} 条`;
            activeFiltersBar.classList.remove("hidden");
            activeFiltersBar.classList.add("flex");
        }

        function render(animate = false) {
            const order = sortMode === "shuffle" ? currentOrder : cardMeta.map((c) => c.index);
            const fragment = document.createDocumentFragment();
            let visibleCount = 0;

            for (const idx of order) {
                const item = cardMeta[idx];
                const matchKind = activeKind === "all" || item.kind === activeKind;
                let matchTags = true;
                for (const tag of activeTags) {
                    if (!item.tags.includes(tag)) {
                        matchTags = false;
                        break;
                    }
                }
                const visible = matchKind && matchTags;
                item.el.hidden = !visible;
                if (visible) {
                    visibleCount += 1;
                }
                fragment.appendChild(item.el);
            }

            listEl.appendChild(fragment);

            listEl.classList.remove("is-shuffling");
            if (animate) {
                void listEl.offsetWidth;
                listEl.classList.add("is-shuffling");
                listEl.addEventListener(
                    "animationend",
                    () => listEl.classList.remove("is-shuffling"),
                    { once: true },
                );
            }

            if (kindSelect) {
                kindSelect.value = activeKind;
            }

            if (tagSelect) {
                tagSelect.value = "";
                for (const opt of Array.from(tagSelect.options)) {
                    if (!opt.value) continue;
                    opt.disabled = activeTags.has(opt.value);
                }
            }

            for (const btn of sortButtons) {
                const isActive = btn.dataset.sortMode === sortMode;
                btn.classList.toggle("trail-sort-active", isActive);
                btn.setAttribute("aria-pressed", String(isActive));
            }

            renderFilterChips(visibleCount);

            if (emptyState) {
                emptyState.classList.toggle("hidden", visibleCount > 0);
            }

            syncUrl();
        }

        if (sortMode === "shuffle") {
            currentOrder = shuffleOrder(currentOrder);
        }

        kindSelect?.addEventListener("change", () => {
            activeKind = kindSelect.value || "all";
            render();
        });

        tagSelect?.addEventListener("change", () => {
            const tag = tagSelect.value;
            if (tag && validTags.has(tag)) {
                activeTags.add(tag);
                render();
            }
        });

        for (const btn of sortButtons) {
            btn.addEventListener("click", () => {
                const mode = btn.dataset.sortMode === "shuffle" ? "shuffle" : "time";
                if (mode === "shuffle") {
                    sortMode = "shuffle";
                    currentOrder = shuffleOrder(currentOrder);
                    render(true);
                } else {
                    sortMode = "time";
                    render(true);
                }
            });
        }

        listEl.addEventListener("click", (event) => {
            const target = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
                "[data-card-tag]",
            );
            if (!target) return;
            const tag = target.dataset.cardTag;
            if (!tag) return;
            if (activeTags.has(tag)) {
                activeTags.delete(tag);
            } else {
                activeTags.add(tag);
            }
            render();
        });

        const resetFilters = () => {
            activeKind = "all";
            activeTags.clear();
            render();
        };

        resetBtn?.addEventListener("click", resetFilters);
        emptyResetBtn?.addEventListener("click", resetFilters);

        render(false);
    }
</script>
