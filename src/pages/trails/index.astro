---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageMeta from "@/components/PageMeta.astro";
import TrailCard from "@/components/TrailCard.astro";
import { Site } from "@/config";
import { countTerms } from "@/lib/post";
import {
    getAllTrails,
    sortTrailsByDateDesc,
    TRAIL_KIND_META,
    TRAIL_KIND_ORDER,
} from "@/lib/trail";

const trails = sortTrailsByDateDesc(await getAllTrails());
const totalCount = trails.length;
const sortedTags = countTerms(trails.flatMap((entry) => entry.data.tags));
const kindCounts = new Map<string, number>();
for (const entry of trails) {
    kindCounts.set(entry.data.kind, (kindCounts.get(entry.data.kind) ?? 0) + 1);
}

const title = "轨迹";
const description = "中二少年的轨迹：听过的歌、记住的台词，以及驻足过的片段。";
---

<BaseLayout title={`${title} | ${Site.title}`}>
    <PageMeta title={title} description={description} slot="meta" />

    <section class="mt-8">
        <header class="mb-6">
            <h1 class="my-0 text-3xl font-bold text-gray-900">{title}</h1>
            <p class="mt-2 mb-0 text-sm text-gray-500 leading-relaxed">
                {description}
            </p>
        </header>

        <div class="pb-3 border-b border-gray-900/10 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="按类型筛选">
                <button
                    type="button"
                    data-kind-filter="all"
                    aria-pressed="true"
                    class="trail-pill trail-pill-active cursor-pointer rounded-full border px-3 py-1 text-xs font-medium transition-colors"
                >
                    全部 <span class="opacity-65 ml-0.5">{totalCount}</span>
                </button>
                {
                    TRAIL_KIND_ORDER.filter((kind) => (kindCounts.get(kind) ?? 0) > 0).map(
                        (kind) => (
                            <button
                                type="button"
                                data-kind-filter={kind}
                                aria-pressed="false"
                                class="trail-pill cursor-pointer rounded-full border px-3 py-1 text-xs font-medium transition-colors"
                            >
                                {TRAIL_KIND_META[kind].label}{" "}
                                <span class="opacity-65 ml-0.5">{kindCounts.get(kind)}</span>
                            </button>
                        ),
                    )
                }
            </div>

            <div class="flex items-center gap-1.5" role="group" aria-label="排序方式">
                <button
                    type="button"
                    data-sort-mode="time"
                    aria-pressed="true"
                    class="trail-sort-btn trail-sort-active inline-flex items-center gap-1 cursor-pointer rounded-md border px-2.5 py-1 text-xs font-medium transition-colors"
                >
                    <svg
                        class="w-3.5 h-3.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />
                    </svg>
                    <span>按时间</span>
                </button>
                <button
                    type="button"
                    data-sort-mode="shuffle"
                    aria-pressed="false"
                    class="trail-sort-btn inline-flex items-center gap-1 cursor-pointer rounded-md border px-2.5 py-1 text-xs font-medium transition-colors"
                    title="随机打乱顺序，再次点击可重新洗牌"
                >
                    <svg
                        class="w-3.5 h-3.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M16 3h5v5" />
                        <path d="M4 20 21 3" />
                        <path d="M21 16v5h-5" />
                        <path d="M15 15l6 6" />
                        <path d="M4 4l5 5" />
                    </svg>
                    <span data-shuffle-label>乱序漫游</span>
                </button>
            </div>
        </div>

        {
            sortedTags.length > 0 && (
                <div class="mt-3 flex flex-wrap items-center gap-1.5" role="group" aria-label="按标签筛选">
                    <span class="text-xs text-gray-400 mr-1 select-none">标签</span>
                    {sortedTags.map(({ name, count }) => (
                        <button
                            type="button"
                            data-tag-filter={name}
                            aria-pressed="false"
                            class="trail-tag-chip cursor-pointer rounded-md border px-2 py-0.5 text-xs transition-colors"
                        >
                            #{name}
                            <span class="ml-0.5 text-[11px] opacity-60">{count}</span>
                        </button>
                    ))}
                </div>
            )
        }

        <div
            id="trail-status"
            class="mt-3 hidden items-center justify-between text-xs text-gray-500"
        >
            <span id="trail-status-text"></span>
            <button
                type="button"
                id="trail-reset-btn"
                class="cursor-pointer border-0 bg-transparent p-0 text-xs text-blue-600 hover:text-gray-600"
            >
                重置筛选
            </button>
        </div>

        <div
            id="trail-grid"
            class="mt-6 columns-1 md:columns-2 gap-4"
            data-total={totalCount}
        >
            {trails.map((entry, index) => <TrailCard entry={entry} index={index} />)}
        </div>

        <div
            id="trail-empty"
            class="hidden mt-8 rounded-xl border border-dashed border-gray-300 px-6 py-10 text-center"
        >
            <p class="my-0 text-sm text-gray-500">当前筛选条件下暂无记录。</p>
            <button
                type="button"
                id="trail-empty-reset"
                class="mt-3 cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-1 text-xs font-medium text-gray-700 hover:border-gray-400 hover:text-gray-900"
            >
                显示全部轨迹
            </button>
        </div>
    </section>
</BaseLayout>

<style>
    .trail-pill {
        border-color: rgba(17, 24, 39, 0.12);
        background-color: #fff;
        color: #4b5563;
    }

    .trail-pill:hover {
        border-color: rgba(17, 24, 39, 0.25);
        color: #111827;
    }

    .trail-pill-active {
        border-color: #111827;
        background-color: #111827;
        color: #fff;
    }

    .trail-pill-active:hover {
        border-color: #111827;
        color: #fff;
    }

    .trail-sort-btn {
        border-color: rgba(17, 24, 39, 0.12);
        background-color: #fff;
        color: #4b5563;
    }

    .trail-sort-btn:hover {
        border-color: rgba(17, 24, 39, 0.25);
        color: #111827;
    }

    .trail-sort-active {
        border-color: #2563eb;
        background-color: #eff6ff;
        color: #1d4ed8;
    }

    .trail-sort-active:hover {
        border-color: #1d4ed8;
        color: #1d4ed8;
    }

    .trail-tag-chip {
        border-color: rgba(17, 24, 39, 0.1);
        background-color: #f9fafb;
        color: #4b5563;
    }

    .trail-tag-chip:hover {
        border-color: #93c5fd;
        background-color: #eff6ff;
        color: #1d4ed8;
    }

    .trail-tag-active {
        border-color: #2563eb;
        background-color: #2563eb;
        color: #fff;
    }

    .trail-tag-active:hover {
        border-color: #1d4ed8;
        background-color: #1d4ed8;
        color: #fff;
    }

    @keyframes trail-settle {
        from {
            opacity: 0.45;
            transform: translateY(4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    :global(#trail-grid.is-shuffling [data-trail-card]) {
        animation: trail-settle 0.24s ease-out;
    }

    :global([data-trail-card][hidden]),
    #trail-reset-btn[hidden] {
        display: none !important;
    }
</style>

<script>
    const grid = document.getElementById("trail-grid");
    if (grid) {
        const gridEl: HTMLElement = grid;
        const cards = Array.from(gridEl.querySelectorAll<HTMLElement>("[data-trail-card]"));
        const kindButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-kind-filter]"));
        const tagButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]"));
        const sortButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-sort-mode]"));
        const shuffleLabel = document.querySelector<HTMLElement>("[data-shuffle-label]");
        const statusBar = document.getElementById("trail-status");
        const statusText = document.getElementById("trail-status-text");
        const resetBtn = document.getElementById("trail-reset-btn");
        const emptyState = document.getElementById("trail-empty");
        const emptyResetBtn = document.getElementById("trail-empty-reset");

        const validKinds = new Set(kindButtons.map((btn) => btn.dataset.kindFilter || "all"));
        const validTags = new Set(tagButtons.map((btn) => btn.dataset.tagFilter || ""));

        const params = new URLSearchParams(window.location.search);
        const initialKind = params.get("kind");
        const initialTag = params.get("tag");
        const initialOrder = params.get("order");

        let activeKind = initialKind && validKinds.has(initialKind) ? initialKind : "all";
        let activeTag = initialTag && validTags.has(initialTag) ? initialTag : null;
        let sortMode: "time" | "shuffle" = initialOrder === "random" ? "shuffle" : "time";
        let currentOrder = cards.map((_, idx) => idx);

        function parseTags(card: HTMLElement): string[] {
            try {
                const raw = card.dataset.tags;
                return raw ? JSON.parse(raw) : [];
            } catch {
                return [];
            }
        }

        const cardMeta = cards.map((el, index) => ({
            el,
            index,
            kind: el.dataset.kind || "reference",
            tags: parseTags(el),
        }));

        function shuffleOrder(prev: number[]): number[] {
            const next = [...prev];
            for (let i = next.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [next[i], next[j]] = [next[j], next[i]];
            }
            if (next.length > 1 && next.every((v, idx) => v === prev[idx])) {
                [next[0], next[1]] = [next[1], next[0]];
            }
            return next;
        }

        function syncUrl() {
            const url = new URL(window.location.href);
            if (activeKind !== "all") {
                url.searchParams.set("kind", activeKind);
            } else {
                url.searchParams.delete("kind");
            }
            if (activeTag) {
                url.searchParams.set("tag", activeTag);
            } else {
                url.searchParams.delete("tag");
            }
            if (sortMode === "shuffle") {
                url.searchParams.set("order", "random");
            } else {
                url.searchParams.delete("order");
            }
            window.history.replaceState({}, "", url.pathname + url.search + url.hash);
        }

        function render(animate = false) {
            const order = sortMode === "shuffle" ? currentOrder : cardMeta.map((c) => c.index);
            const fragment = document.createDocumentFragment();
            let visibleCount = 0;

            for (const idx of order) {
                const item = cardMeta[idx];
                const matchKind = activeKind === "all" || item.kind === activeKind;
                const matchTag = !activeTag || item.tags.includes(activeTag);
                const visible = matchKind && matchTag;
                item.el.hidden = !visible;
                if (visible) {
                    visibleCount += 1;
                }
                fragment.appendChild(item.el);
            }

            gridEl.appendChild(fragment);

            if (animate) {
                gridEl.classList.remove("is-shuffling");
                void gridEl.offsetWidth;
                gridEl.classList.add("is-shuffling");
            }

            for (const btn of kindButtons) {
                const isActive = btn.dataset.kindFilter === activeKind;
                btn.classList.toggle("trail-pill-active", isActive);
                btn.setAttribute("aria-pressed", String(isActive));
            }

            for (const btn of tagButtons) {
                const isActive = btn.dataset.tagFilter === activeTag;
                btn.classList.toggle("trail-tag-active", isActive);
                btn.setAttribute("aria-pressed", String(isActive));
            }

            for (const btn of sortButtons) {
                const isActive = btn.dataset.sortMode === sortMode;
                btn.classList.toggle("trail-sort-active", isActive);
                btn.setAttribute("aria-pressed", String(isActive));
            }

            if (shuffleLabel) {
                shuffleLabel.textContent = sortMode === "shuffle" ? "再洗一次" : "乱序漫游";
            }

            const hasFilter = activeKind !== "all" || activeTag !== null;
            if (statusBar && statusText) {
                if (hasFilter || sortMode === "shuffle") {
                    const parts: string[] = [];
                    if (hasFilter) {
                        parts.push(`显示 ${visibleCount} / ${cards.length} 条`);
                    }
                    if (activeTag) {
                        parts.push(`标签 #${activeTag}`);
                    }
                    if (sortMode === "shuffle") {
                        parts.push("当前为乱序漫游");
                    }
                    statusText.textContent = parts.join(" · ");
                    statusBar.classList.remove("hidden");
                    statusBar.classList.add("flex");
                    if (resetBtn) {
                        resetBtn.hidden = !hasFilter;
                    }
                } else {
                    statusBar.classList.add("hidden");
                    statusBar.classList.remove("flex");
                }
            }

            if (emptyState) {
                emptyState.classList.toggle("hidden", visibleCount > 0);
            }

            syncUrl();
        }

        if (sortMode === "shuffle") {
            currentOrder = shuffleOrder(currentOrder);
        }

        for (const btn of kindButtons) {
            btn.addEventListener("click", () => {
                activeKind = btn.dataset.kindFilter || "all";
                render();
            });
        }

        for (const btn of tagButtons) {
            btn.addEventListener("click", () => {
                const tag = btn.dataset.tagFilter || null;
                activeTag = activeTag === tag ? null : tag;
                render();
            });
        }

        for (const btn of sortButtons) {
            btn.addEventListener("click", () => {
                const mode = btn.dataset.sortMode === "shuffle" ? "shuffle" : "time";
                if (mode === "shuffle") {
                    sortMode = "shuffle";
                    currentOrder = shuffleOrder(currentOrder);
                    render(true);
                } else {
                    sortMode = "time";
                    render(true);
                }
            });
        }

        grid.addEventListener("click", (event) => {
            const target = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
                "[data-card-tag]",
            );
            if (!target) return;
            const tag = target.dataset.cardTag || null;
            if (!tag) return;
            activeTag = activeTag === tag ? null : tag;
            render();
        });

        const resetFilters = () => {
            activeKind = "all";
            activeTag = null;
            render();
        };

        resetBtn?.addEventListener("click", resetFilters);
        emptyResetBtn?.addEventListener("click", resetFilters);

        render(false);
    }
</script>
