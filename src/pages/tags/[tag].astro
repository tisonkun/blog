---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageMeta from "@/components/PageMeta.astro";
import PostList from "@/components/PostList.astro";
import { getListedPosts, type PostEntry } from "@/lib/post";
import { Site } from "@/config";

interface Props {
    posts: PostEntry[];
    tag: string;
}

export async function getStaticPaths() {
    const posts = await getListedPosts();
    const grouped = new Map<string, PostEntry[]>();
    for (const post of posts) {
        for (const tag of post.data.tags) {
            const list = grouped.get(tag) ?? [];
            list.push(post);
            grouped.set(tag, list);
        }
    }
    return [...grouped.entries()].map(([tag, tagPosts]) => ({
        params: { tag },
        props: { posts: tagPosts, tag },
    }));
}

const { posts, tag } = Astro.props;
---

<BaseLayout title={`${tag} | ${Site.title}`}>
    <PageMeta title={tag} slot="meta" />
    <h1 class="text-center text-4xl font-bold mt-8">{tag}</h1>
    <PostList posts={posts} />
</BaseLayout>
