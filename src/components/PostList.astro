---
import DateTile from "./DateTile.astro";
import { getPostExcerpt, sortPostsByDateDesc, type PostEntry } from "@/lib/post";

interface Props {
    posts: PostEntry[];
}

const { posts } = Astro.props;
const sortedPosts = sortPostsByDateDesc(posts);
---

<ul>
    {
        sortedPosts.map((entry) => (
            <li class="grid grid-cols-12 mt-8 gap-2">
                <DateTile date={entry.data.date} />
                <div class="col-span-10">
                    <h3 class="text-2xl leading-snug mb-1 mt-0">
                        <a href={`/posts/${entry.id}`}>{entry.data.title}</a>
                    </h3>
                    <p class="my-0 text-sm text-gray-600 leading-relaxed">
                        {getPostExcerpt(entry, 120)}
                    </p>
                </div>
            </li>
        ))
    }
</ul>
