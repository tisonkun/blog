---
import { TRAIL_KIND_META, type TrailKind } from "@/lib/trail";

interface Props {
    kind: TrailKind;
}

const { kind } = Astro.props;
const meta = TRAIL_KIND_META[kind];
---

<span
    class={`inline-flex items-center shrink-0 rounded-md border px-2 py-0.5 text-xs font-medium leading-tight ${meta.badgeClass}`}
>
    {meta.label}
</span>
