---
import { render } from "astro:content";
import TrailKindBadge from "@/components/TrailKindBadge.astro";
import {
    formatTrailDate,
    getTrailLinks,
    hasTrailNote,
    type TrailEntry,
} from "@/lib/trail";

interface Props {
    entry: TrailEntry;
    index: number;
}

const { entry, index } = Astro.props;
const { title, date, kind, credit, source, quote, tags } = entry.data;
const formattedDate = formatTrailDate(date);
const links = getTrailLinks(entry);
const hasNote = hasTrailNote(entry);
const subtitle = [credit, source].filter(Boolean).join(" · ");
const { Content } = hasNote ? await render(entry) : { Content: null };
---

<article
    class="trail-card break-inside-avoid mb-4 flex flex-col rounded-xl border border-gray-900/10 bg-white p-5 transition-all duration-150 hover:border-gray-900/20 hover:shadow-[0_4px_16px_rgba(17,24,39,0.06)]"
    data-trail-card
    data-index={index}
    data-kind={kind}
    data-tags={JSON.stringify(tags)}
>
    <div class="flex items-center justify-between gap-2">
        <TrailKindBadge kind={kind} />
        <a
            href={`/trails/${entry.id}`}
            class="font-mono text-xs text-gray-400 hover:text-gray-700 tabular-nums transition-colors"
            title="查看详情与讨论"
        >
            <time datetime={date.toISOString()}>{formattedDate}</time>
        </a>
    </div>

    <h2 class="mt-3 mb-0 text-lg font-semibold leading-snug">
        <a
            href={`/trails/${entry.id}`}
            class="text-gray-900 hover:text-blue-600 transition-colors"
        >
            {title}
        </a>
    </h2>

    {
        subtitle && (
            <p class="mt-1 mb-0 text-xs text-gray-500 leading-relaxed">
                {subtitle}
            </p>
        )
    }

    {
        quote && (
            <div class="mt-3 rounded-lg border border-[#e7e5e0] bg-[#f8f8f6] px-3.5 py-2.5 text-[0.9rem] leading-relaxed text-gray-800 whitespace-pre-line">
                {quote}
            </div>
        )
    }

    {
        Content && (
            <div class="trail-card-note mt-3 text-sm leading-relaxed text-gray-600">
                <Content />
            </div>
        )
    }

    {
        links.length > 0 && (
            <div class="mt-3.5 flex flex-wrap gap-1.5">
                {links.map((link) => (
                    <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 rounded-md border border-gray-200 bg-gray-50/80 px-2.5 py-1 text-xs font-medium text-gray-700 hover:border-blue-300 hover:bg-blue-50/60 hover:text-blue-700 transition-colors"
                    >
                        <span>{link.label}</span>
                        <svg
                            class="w-3 h-3 opacity-70"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M7 17 17 7" />
                            <path d="M7 7h10v10" />
                        </svg>
                    </a>
                ))}
            </div>
        )
    }

    <div class="mt-auto pt-4">
        <div
            class="flex items-center justify-between gap-2 pt-3 border-t border-gray-900/6"
        >
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 min-w-0">
                {
                    tags.map((tag) => (
                        <button
                            type="button"
                            data-card-tag={tag}
                            class="cursor-pointer border-0 bg-transparent p-0 text-xs text-gray-500 hover:text-blue-600 transition-colors"
                        >
                            #{tag}
                        </button>
                    ))
                }
            </div>
            <a
                href={`/trails/${entry.id}#comments`}
                class="inline-flex items-center gap-1 shrink-0 text-xs text-gray-400 hover:text-blue-600 transition-colors"
                title="进入讨论串"
            >
                <svg
                    class="w-3.5 h-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path
                        d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                    />
                </svg>
                <span>讨论</span>
            </a>
        </div>
    </div>
</article>

<style>
    .trail-card-note :global(p) {
        margin: 0.45rem 0;
        font-size: 0.875rem;
        line-height: 1.65;
    }

    .trail-card-note :global(p:first-child) {
        margin-top: 0;
    }

    .trail-card-note :global(p:last-child) {
        margin-bottom: 0;
    }

    .trail-card-note :global(blockquote) {
        margin: 0.5rem 0;
        padding: 0.6rem 0.85rem;
        font-size: 0.85rem;
    }
</style>
