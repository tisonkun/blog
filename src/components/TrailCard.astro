---
import { render } from "astro:content";
import DateTile from "@/components/DateTile.astro";
import { hasTrailBody, type TrailEntry } from "@/lib/trail";

interface Props {
    entry: TrailEntry;
    index: number;
}

const { entry, index } = Astro.props;
const { title, date, work, credit } = entry.data;
const hasBody = hasTrailBody(entry);
const { Content } = hasBody ? await render(entry) : { Content: null };
---

<li
    class="trail-item grid grid-cols-12 gap-3 sm:gap-4 items-start list-none"
    data-trail-card
    data-index={index}
    data-work={work ?? ""}
>
    <DateTile date={date} />
    <article
        class="col-span-10 rounded-xl border border-gray-900/10 bg-white px-5 py-4 transition-all duration-150 hover:border-gray-900/20 hover:shadow-[0_4px_16px_rgba(17,24,39,0.06)]"
    >
        <div class="flex items-baseline justify-between gap-3">
            <h2 class="my-0 text-xl font-semibold leading-snug">
                <a
                    href={`/trails/${entry.id}`}
                    class="text-gray-900 hover:text-blue-600 transition-colors"
                >
                    {title}
                </a>
            </h2>
            <a
                href={`/trails/${entry.id}#comments`}
                class="shrink-0 text-xs text-gray-400 hover:text-blue-600 transition-colors"
                title="进入讨论串"
            >
                讨论
            </a>
        </div>

        {
            (work || credit) && (
                <p class="mt-1 mb-0 text-sm text-gray-500 leading-relaxed">
                    {work && (
                        <button
                            type="button"
                            data-card-work={work}
                            class="cursor-pointer border-0 bg-transparent p-0 text-sm text-gray-600 hover:text-blue-600 transition-colors"
                            title={`按作品《${work}》筛选`}
                        >
                            《{work}》
                        </button>
                    )}
                    {work && credit && <span class="mx-1.5 text-gray-300">·</span>}
                    {credit && <span>{credit}</span>}
                </p>
            )
        }

        {
            Content && (
                <div class="trail-card-body mt-3 text-[0.95rem] leading-relaxed text-gray-700">
                    <Content />
                </div>
            )
        }
    </article>
</li>

<style>
    .trail-card-body :global(p) {
        margin: 0.6rem 0;
        font-size: 0.94rem;
        line-height: 1.7;
    }

    .trail-card-body :global(p:first-child) {
        margin-top: 0;
    }

    .trail-card-body :global(p:last-child) {
        margin-bottom: 0;
    }

    .trail-card-body :global(blockquote) {
        margin: 0.75rem 0;
        padding: 0.8rem 1.1rem;
        font-size: 0.92rem;
        line-height: 1.7;
    }

    .trail-card-body :global(blockquote:first-child) {
        margin-top: 0;
    }

    .trail-card-body :global(blockquote:last-child) {
        margin-bottom: 0;
    }

    .trail-card-body :global(blockquote p) {
        margin: 0.4rem 0;
    }

    .trail-card-body :global(blockquote p:first-child) {
        margin-top: 0;
    }

    .trail-card-body :global(blockquote p:last-child) {
        margin-bottom: 0;
    }
</style>
