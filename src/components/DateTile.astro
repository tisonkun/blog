---
import { getSiteDateParts } from "@/lib/date";

interface Props {
    date: Date;
}

const { date } = Astro.props;
const { year, month, day } = getSiteDateParts(date);
---

<div class="col-span-2 text-center">
    <span class="block text-5xl font-semibold leading-none">{day}</span>
    <span class="block text-sm text-gray-500 mt-1">{year}-{month}</span>
</div>
